# ==============================================================================
# Arafat Poultry & Fisheries Management System
# Production & Development Environment Configuration Template
# ==============================================================================
# এই ফাইলটি একটি টেমপ্লেট। প্রোডাকশন বা লোকাল সেটআপের জন্য এই ফাইলটি কপি করে 
# `.env` নামে সেভ করুন এবং সংবেদনশীল পাসওয়ার্ড/সিক্রেট কি প্রদান করুন।
#
# নির্দেশিকা:
# ১. কখনোই প্রোডাকশন পাসওয়ার্ড বা সিক্রেট কি গিট রিপোজিটরিতে পুশ করবেন না।
# ২. `.gitignore` ফাইলে `.env*` অন্তর্ভুক্ত নিশ্চিত করা হয়েছে।
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (ডাটাবেজ সংযোগ কনফিগারেশন)
# ------------------------------------------------------------------------------
# MySQL 8.0+ Connection URL
# ফরম্যাট: mysql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]
DATABASE_URL="mysql://root:@127.0.0.1:3306/arafat_poultry_db"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (সিকিউরিটি ও টোকেন এনক্রিপশন)
# ------------------------------------------------------------------------------
# JSON Web Token (JWT) সাইনিং সিক্রেট কি। প্রোডাকশন সার্ভারে অবশ্যই একটি শক্তিশালী, 
# অনন্য ও ক্রিপ্টোগ্রাফিকভাবে সুরক্ষিত ৬৪+ অক্ষরের স্ট্রিং ব্যবহার করুন।
# উদাহরণ জেনারেট করতে পারেন: `openssl rand -base64 48`
JWT_SECRET="replace_with_strong_64_char_cryptographic_secret_key_for_arafat_poultry"

# ------------------------------------------------------------------------------
# 3. APPLICATION BRANDING & PUBLIC URL (অ্যাপ্লিকেশন ব্রান্ডিং ও ইউআরএল)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Arafat Poultry & Fisheries"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. SYSTEM LOCALE & CURRENCY (স্থানীয়করণ ও মুদ্রা সেটিংস)
# ------------------------------------------------------------------------------
# Default currency symbol: ৳ (BDT)
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"
